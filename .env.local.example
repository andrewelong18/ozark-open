NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Leaderboard (Sprint 8) — read-only Google Sheets service account. Create a
# service account, enable the Sheets API, and share the "Sportsbook Leaderboard"
# sheet with the account's email as Viewer. Server-only: no NEXT_PUBLIC_ prefix.
GOOGLE_SERVICE_ACCOUNT_EMAIL=name@project.iam.gserviceaccount.com
# Paste the private key from the service-account JSON, newlines escaped as \n
# (wrap the whole value in quotes).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The leaderboard spreadsheet's ID (the long token in its URL).
GOOGLE_SHEET_ID=your_leaderboard_spreadsheet_id

# Admin-created members (Sprint 23 / #124). The Supabase SERVICE ROLE key —
# Dashboard -> Settings -> API. Used by exactly one route
# (POST /api/admin/members) to create an auth account for a member who can't get
# through the magic-link flow, because public.users.id is a foreign key to
# auth.users and the anon key cannot write there.
#
# THIS KEY BYPASSES ROW-LEVEL SECURITY ENTIRELY. Never give it a NEXT_PUBLIC_
# prefix, never import lib/supabase/admin.ts anywhere else (a unit test pins
# that), and keep it out of git. Everything else in the app runs on the anon key
# and its RLS policies — see lib/supabase/admin.ts for why this exception exists
# and DATA_MODEL.md §5 for the reasoning it overrides.
#
# OPTIONAL: leave it unset and the whole app works except the "Add a member"
# form on /admin/people, which answers with a legible "not configured" message.
SUPABASE_SERVICE_ROLE_KEY=

# Bet-state snapshots (Sprint 11). How many save states to keep — the oldest are
# pruned each time a new one is taken. Optional; defaults to 50, which is
# deliberately generous because a payload for a 32-person pool is a few hundred
# KB. A missing, empty, zero or negative value falls back to the default rather
# than asking the database to prune everything.
SNAPSHOT_RETENTION=50

# --- Agent automation (see docs/AGENT_AUTOMATION.md) --------------------------
# These let Claude Code do the manual Supabase/Vercel chores itself. All free
# tier. Set them in your environment (or here — .env* is gitignored); the app
# itself does NOT read them, so leaving them blank never breaks the site.
#
# Supabase personal access token (Account -> Access Tokens). Powers the Supabase
# MCP in .mcp.json (apply migrations, data edits) and scripts/prod-auth-config.sh.
SUPABASE_ACCESS_TOKEN=sbp_...
# Vercel token (Account Settings -> Tokens). Powers `vercel env add` for #66,
# since the official Vercel MCP can't manage env vars.
VERCEL_TOKEN=
